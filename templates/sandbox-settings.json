{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "~/.claude/hooks/workspace-only.sh" }]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "forge issue *",
      "forge pr *",
      "forge doctor",
      "forge run *",
      "forge qa *",
      "forge cleanup *"
    ],
    "filesystem": {
      "denyRead": ["~/.config/gh"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(forge issue view *)",
      "Bash(forge pr view *)",
      "Bash(forge doctor)"
    ],
    "ask": [
      "Bash(forge issue create *)",
      "Bash(forge issue edit *)",
      "Bash(forge pr push *)",
      "Bash(forge run *)",
      "Bash(forge qa *)",
      "Bash(forge cleanup *)"
    ]
  }
}
