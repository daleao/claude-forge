#!/usr/bin/env bash
# Stub claude. Every call leaves <n>.args (one argument per line), <n>.kind and,
# for a headless call, <n>.prompt in $FORGE_TEST_CALLS. What it does:
#   mcp get <server>     prints $FORGE_TEST_MCP_STATUS
#   -p --agent forge:*   prints a clean report of that reviewer's kind (the code
#                        reviewer has one blocker when FORGE_TEST_FINDING is set)
#   -p, in a slice       commits the files a slice would (see below), sets its state to done,
#                        and records a choice when FORGE_TEST_CHOICE is set
#   -p, a choices check  NONE, or a contradiction when FORGE_TEST_CONTRADICT is set
#   -p, anywhere else    nothing (a fixer or the cleanup pass with nothing to do); a
#                        fixer parks its finding when FORGE_TEST_PARK is set
set -u
mkdir -p "$FORGE_TEST_CALLS"
n="$(find "$FORGE_TEST_CALLS" -name '*.args' | wc -l | tr -d ' ')"; n="$FORGE_TEST_CALLS/$(printf '%03d' "$n")-$$"
printf '%s\n' "$@" > "$n.args"
printf '%s %s\n' "${FORGE_CTX_WARN:-}" "${FORGE_CTX_CRITICAL:-}" > "$n.ctx"
if [[ "${1:-}" == mcp ]]; then echo mcp > "$n.kind"; printf '%s:\n  Status: %s\n' "${3:-}" "${FORGE_TEST_MCP_STATUS:-✔ Connected}"; exit 0; fi
cat > "$n.prompt"
agent=""; prev=""
for a in "$@"; do [[ "$prev" == --agent ]] && agent="$a"; prev="$a"; done
case "$agent" in
  forge:qa-recheck) echo recheck > "$n.kind"; echo "- [ADDRESSED] a finding — file:1" ;;
  forge:qa-code) echo code > "$n.kind"; printf '### Findings\n'
    if [[ -n "${FORGE_TEST_FINDING:-}" ]]; then echo "- [BLOCKER] f:1 — wrong — a rule — fix it"; else echo "- none"; fi ;;
  forge:qa-*) echo "${agent#forge:qa-}" > "$n.kind"; printf '### Findings\n- none\n' ;;
  *)
    if [[ -n "${FORGE_STATE_FILE:-}" ]]; then
      echo implement > "$n.kind"
      # The slice's work: a file, a rule of its own at the end of the
      # constitution, and an attempt to widen the reviewers' tools from its checkout.
      echo work > "work-$(basename "$PWD").txt"
      if [[ -f .forge/constitution.md ]]; then echo "- Rule added by the slice." >> .forge/constitution.md; fi
      echo 'FORGE_QA_TOOLS=("Edit" "Write")' >> .forge/config.sh
      git add -A >/dev/null && git commit -qm "slice work"
      sed -i 's/^Status: .*/Status: done/' "$FORGE_STATE_FILE"
      if [[ -n "${FORGE_TEST_CHOICE:-}" ]]; then echo "- Choice: a transaction takes its Account's currency — simpler — a wrong total" >> "$FORGE_STATE_FILE"; fi
    elif grep -q 'is about to merge' "$n.prompt"; then
      echo choices > "$n.kind"
      if [[ -n "${FORGE_TEST_CONTRADICT:-}" ]]; then echo "CONTRADICTS a transaction takes its Account's currency — a ruling — they differ"; else echo NONE; fi
    else
      echo other > "$n.kind"
      notes="$(sed -n 's/^Finally write `\([^`]*\)`.*/\1/p' "$n.prompt")"
      if [[ -n "${FORGE_TEST_PARK:-}" && -n "$notes" ]]; then echo "- PARKED f:1 — needs the human: which currency does a transfer take?" > "$notes"; fi
    fi ;;
esac
exit 0
